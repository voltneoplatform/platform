{
  "name": "voltneo-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Volt Neo platform: API, admin panel, Field App and Driver App",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev:api": "pnpm --filter @voltneo/api run start:dev",
    "dev:admin": "pnpm --filter @voltneo/admin run dev",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter @voltneo/api run test:e2e",
    "db:migrate": "pnpm --filter @voltneo/api run db:migrate",
    "db:seed": "pnpm --filter @voltneo/api run db:seed",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "~5.9.3"
  }
}
