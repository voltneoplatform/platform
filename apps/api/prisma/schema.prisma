// Volt Neo platform database (Platform MVP Spec V1, section 5).
// M0: staff, login and the audit log. M1: battery types, inventory, plans,
// approvals, drivers, vehicles and KYC. M2: agreements, instalments,
// installation, payments, the ledger, cash deposits and outbound messages.
// M3: collections (immobilisation log, recoveries, notices, job runs).
// Money is always stored in paise as integers.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  SUPER_ADMIN
  PLAN_MANAGER
  OPERATIONS_MANAGER
  FINANCE
  SUPPORT
  FIELD_AGENT
  TECHNICIAN
  RECOVERY
}

enum StaffStatus {
  ACTIVE
  DEACTIVATED
}

enum OtpChannel {
  EMAIL
  SMS
}

enum SessionClient {
  WEB
  APP
}

enum ActorType {
  STAFF
  DRIVER
  SYSTEM
}

/// staff_users: head-office and field staff. At least one of email or phone is required.
model StaffUser {
  id            String      @id @default(uuid()) @db.Uuid
  name          String
  email         String?     @unique
  phone         String?     @unique
  role          StaffRole
  status        StaffStatus @default(ACTIVE)
  lastLoginAt   DateTime?   @map("last_login_at") @db.Timestamptz(3)
  deactivatedAt DateTime?   @map("deactivated_at") @db.Timestamptz(3)
  createdById   String?     @map("created_by_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy     StaffUser?     @relation("StaffCreatedBy", fields: [createdById], references: [id])
  createdStaff  StaffUser[]    @relation("StaffCreatedBy")
  otpChallenges OtpChallenge[]
  sessions      StaffSession[]

  @@map("staff_users")
}

/// One-time passwords for staff login. Only a hash of the code is stored.
model OtpChallenge {
  id          String     @id @default(uuid()) @db.Uuid
  staffId     String     @map("staff_id") @db.Uuid
  channel     OtpChannel
  destination String
  codeHash    String     @map("code_hash")
  attempts    Int        @default(0)
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(3)
  consumedAt  DateTime?  @map("consumed_at") @db.Timestamptz(3)
  requestIp   String?    @map("request_ip")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  staff StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, createdAt])
  @@map("staff_otp_challenges")
}

/// Refresh-token sessions. Tokens rotate on every refresh; reusing an old token
/// revokes the whole family. Sessions end after inactivity or an absolute limit.
model StaffSession {
  id               String        @id @default(uuid()) @db.Uuid
  staffId          String        @map("staff_id") @db.Uuid
  familyId         String        @map("family_id") @db.Uuid
  refreshTokenHash String        @unique @map("refresh_token_hash")
  client           SessionClient
  userAgent        String?       @map("user_agent")
  ip               String?
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt       DateTime      @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt        DateTime      @map("expires_at") @db.Timestamptz(3)
  rotatedAt        DateTime?     @map("rotated_at") @db.Timestamptz(3)
  revokedAt        DateTime?     @map("revoked_at") @db.Timestamptz(3)
  revokedReason    String?       @map("revoked_reason")

  staff StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([familyId])
  @@map("staff_sessions")
}

/// audit_log: append-only record of every change to money, plans, agreement
/// state, battery custody and staff access (spec section 3, rule 17).
/// A database trigger blocks UPDATE and DELETE.
model AuditLog {
  id        BigInt    @id @default(autoincrement())
  actorType ActorType @map("actor_type")
  actorId   String?   @map("actor_id") @db.Uuid
  action    String
  tableName String    @map("table_name")
  recordId  String?   @map("record_id")
  before    Json?
  after     Json?
  ip        String?
  requestId String?   @map("request_id")
  at        DateTime  @default(now()) @db.Timestamptz(3)

  @@index([tableName, recordId])
  @@index([actorId, at])
  @@index([at])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// M1: set-up data. Columns ending in _by_id hold a staff_users.id; staff are
// never deleted (only deactivated), so they carry no foreign key.
// ---------------------------------------------------------------------------

enum VehicleType {
  TOTO
  E_RICKSHAW
  E_THREE_WHEELER
}

enum BatteryTypeStatus {
  ACTIVE
  ARCHIVED
}

/// battery_types: the 4-5 types bought from the supplier (D8, D28, D29).
model BatteryType {
  id                 String            @id @default(uuid()) @db.Uuid
  name               String            @unique
  voltage            Decimal           @db.Decimal(6, 1)
  capacityAh         Decimal           @map("capacity_ah") @db.Decimal(7, 1)
  chemistry          String
  supplier           String
  warrantyMonths     Int               @map("warranty_months")
  warrantyNotes      String?           @map("warranty_notes")
  compatibleVehicles VehicleType[]     @map("compatible_vehicles")
  notes              String?
  status             BatteryTypeStatus @default(ACTIVE)
  createdById        String?           @map("created_by_id") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  costs      BatteryTypeCost[]
  batteries  Battery[]
  planPrices PlanVersionPrice[]
  agreements Agreement[]

  @@map("battery_types")
}

/// Purchase cost and cost-floor allowances, in paise. Rows are never changed:
/// a new row is added for every change, and the newest row is current.
model BatteryTypeCost {
  id               String   @id @default(uuid()) @db.Uuid
  batteryTypeId    String   @map("battery_type_id") @db.Uuid
  purchaseCost     Int      @map("purchase_cost")
  gpsCost          Int      @default(0) @map("gps_cost")
  serviceCost      Int      @default(0) @map("service_cost")
  financingCost    Int      @default(0) @map("financing_cost")
  collectionCost   Int      @default(0) @map("collection_cost")
  expectedLossCost Int      @default(0) @map("expected_loss_cost")
  costFloor        Int      @map("cost_floor")
  note             String?
  enteredById      String?  @map("entered_by_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  batteryType BatteryType @relation(fields: [batteryTypeId], references: [id])

  @@index([batteryTypeId, createdAt])
  @@map("battery_type_costs")
}

enum BatteryStatus {
  IN_STOCK
  INSTALLED
  UNDER_REPAIR
  RECOVERED
  TRANSFERRED
  RETIRED
}

enum CustodyHolder {
  STOCK
  TECHNICIAN
  DRIVER
  RECOVERED
  RETIRED
}

/// batteries: every physical battery, by serial number and GPS device ID.
model Battery {
  id             String        @id @default(uuid()) @db.Uuid
  serial         String        @unique
  batteryTypeId  String        @map("battery_type_id") @db.Uuid
  gpsDeviceId    String?       @unique @map("gps_device_id")
  status         BatteryStatus @default(IN_STOCK)
  holder         CustodyHolder @default(STOCK)
  location       String?
  holderStaffId  String?       @map("holder_staff_id") @db.Uuid
  holderDriverId String?       @map("holder_driver_id") @db.Uuid
  purchaseDate   DateTime      @map("purchase_date") @db.Date
  purchaseCost   Int           @map("purchase_cost")
  supplierRef    String?       @map("supplier_ref")
  notes          String?
  retiredAt      DateTime?     @map("retired_at") @db.Timestamptz(3)
  createdById    String?       @map("created_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  batteryType  BatteryType      @relation(fields: [batteryTypeId], references: [id])
  holderDriver Driver?          @relation(fields: [holderDriverId], references: [id])
  custody      BatteryCustody[]
  agreements    Agreement[]
  installations Installation[]

  @@index([batteryTypeId])
  @@index([status])
  @@map("batteries")
}

/// battery_custody: every change of status, holder or location, oldest first.
model BatteryCustody {
  id         String         @id @default(uuid()) @db.Uuid
  batteryId  String         @map("battery_id") @db.Uuid
  event      String
  fromStatus BatteryStatus? @map("from_status")
  toStatus   BatteryStatus  @map("to_status")
  fromHolder CustodyHolder? @map("from_holder")
  toHolder   CustodyHolder  @map("to_holder")
  toLocation String?        @map("to_location")
  toStaffId  String?        @map("to_staff_id") @db.Uuid
  toDriverId String?        @map("to_driver_id") @db.Uuid
  note       String?
  byId       String?        @map("by_id") @db.Uuid
  at         DateTime       @default(now()) @db.Timestamptz(3)

  battery Battery @relation(fields: [batteryId], references: [id])

  @@index([batteryId, at])
  @@map("battery_custody")
}

enum PlanStatus {
  DRAFT
  ACTIVE
  RETIRED
}

/// plans: Neo Own plan types (D25-D27). The code never changes; names can.
model Plan {
  id          String     @id @default(uuid()) @db.Uuid
  seq         Int        @unique
  code        String     @unique
  nameBn      String     @map("name_bn")
  nameHi      String     @map("name_hi")
  nameEn      String     @map("name_en")
  status      PlanStatus @default(DRAFT)
  createdById String?    @map("created_by_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  versions PlanVersion[]

  @@map("plans")
}

enum PlanVersionStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  SUPERSEDED
}

/// plan_versions: the terms a driver signs. A published version never changes
/// (spec rule 1); names are copied in when it is published.
model PlanVersion {
  id                    String            @id @default(uuid()) @db.Uuid
  planId                String            @map("plan_id") @db.Uuid
  version               Int
  status                PlanVersionStatus @default(DRAFT)
  termMonths            Int?              @map("term_months")
  graceDays             Int               @map("grace_days")
  lateFeePerDayPaise    Int               @map("late_fee_per_day_paise")
  lateFeeCapDays        Int               @map("late_fee_cap_days")
  nameBn                String?           @map("name_bn")
  nameHi                String?           @map("name_hi")
  nameEn                String?           @map("name_en")
  notes                 String?
  costFloorPassed       Boolean?          @map("cost_floor_passed")
  costFloorCheck        Json?             @map("cost_floor_check")
  costFloorException    Boolean           @default(false) @map("cost_floor_exception")
  approvalRequestId     String?           @map("approval_request_id") @db.Uuid
  exceptionApprovedById String?           @map("exception_approved_by_id") @db.Uuid
  publishedById         String?           @map("published_by_id") @db.Uuid
  publishedAt           DateTime?         @map("published_at") @db.Timestamptz(3)
  createdById           String?           @map("created_by_id") @db.Uuid
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  plan   Plan               @relation(fields: [planId], references: [id])
  prices PlanVersionPrice[]
  agreements Agreement[]

  @@unique([planId, version])
  @@map("plan_versions")
}

/// The price grid: one row per eligible battery type, in paise.
model PlanVersionPrice {
  id            String @id @default(uuid()) @db.Uuid
  planVersionId String @map("plan_version_id") @db.Uuid
  batteryTypeId String @map("battery_type_id") @db.Uuid
  downPayment   Int    @map("down_payment")
  instalment    Int
  totalPayable  Int    @map("total_payable")
  costFloor     Int?   @map("cost_floor")

  planVersion PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  batteryType BatteryType @relation(fields: [batteryTypeId], references: [id])

  @@unique([planVersionId, batteryTypeId])
  @@index([batteryTypeId])
  @@map("plan_version_prices")
}

enum ApprovalType {
  IMMOBILISE
  RESTORE
  RECOVER
  VARIATION
  REFUND
  WRITE_OFF
  PAYMENT_EDIT
  BATTERY_RETIRE
  COST_FLOOR_EXCEPTION
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// approval_requests: maker-checker (D19, D26). One person requests, a
/// different eligible person approves or rejects.
model ApprovalRequest {
  id            String         @id @default(uuid()) @db.Uuid
  type          ApprovalType
  targetTable   String         @map("target_table")
  targetId      String         @map("target_id")
  summary       String
  reason        String
  payload       Json?
  status        ApprovalStatus @default(PENDING)
  requestedById String         @map("requested_by_id") @db.Uuid
  requestedAt   DateTime       @default(now()) @map("requested_at") @db.Timestamptz(3)
  decidedById   String?        @map("decided_by_id") @db.Uuid
  decidedAt     DateTime?      @map("decided_at") @db.Timestamptz(3)
  decisionNote  String?        @map("decision_note")

  @@index([status, type])
  @@index([targetTable, targetId])
  @@map("approval_requests")
}

enum DriverLanguage {
  BN
  HI
  EN
}

enum DriverStatus {
  ACTIVE
  INACTIVE
}

/// drivers: the customer. Phone numbers may repeat (shared phones) but are flagged.
model Driver {
  id              String         @id @default(uuid()) @db.Uuid
  name            String
  phone           String
  altPhone        String?        @map("alt_phone")
  language        DriverLanguage
  dateOfBirth     DateTime?      @map("date_of_birth") @db.Date
  addressLine     String         @map("address_line")
  area            String?
  district        String
  state           String         @default("West Bengal")
  pinCode         String         @map("pin_code")
  status          DriverStatus   @default(ACTIVE)
  nomineeName     String?        @map("nominee_name")
  nomineeRelation String?        @map("nominee_relation")
  nomineePhone    String?        @map("nominee_phone")
  notes           String?
  createdById     String?        @map("created_by_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  kycDocuments KycDocument[]
  vehicles     Vehicle[]
  batteries    Battery[]
  agreements   Agreement[]
  payments     Payment[]

  @@index([phone])
  @@map("drivers")
}

enum KycDocType {
  AADHAAR
  VOTER_ID
  DRIVING_LICENCE
  PAN
  PASSPORT
  RATION_CARD
  OTHER_ID
  DRIVER_PHOTO
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// kyc_documents: ID numbers are encrypted (Aadhaar: last 4 digits only) and
/// files are stored privately. number_index is a keyed fingerprint used only
/// to find the same document on two drivers.
model KycDocument {
  id              String     @id @default(uuid()) @db.Uuid
  driverId        String     @map("driver_id") @db.Uuid
  type            KycDocType
  numberEncrypted String?    @map("number_encrypted")
  numberLast4     String?    @map("number_last4")
  numberIndex     String?    @map("number_index")
  usedForAddress  Boolean    @default(false) @map("used_for_address")
  fileKey         String     @map("file_key")
  fileName        String     @map("file_name")
  fileType        String     @map("file_type")
  fileSize        Int        @map("file_size")
  status          KycStatus  @default(PENDING)
  verifiedById    String?    @map("verified_by_id") @db.Uuid
  verifiedAt      DateTime?  @map("verified_at") @db.Timestamptz(3)
  rejectionReason String?    @map("rejection_reason")
  uploadedById    String?    @map("uploaded_by_id") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  driver Driver @relation(fields: [driverId], references: [id])

  @@index([driverId])
  @@index([numberIndex])
  @@map("kyc_documents")
}

/// vehicles: the driver's vehicle. For renter-drivers the owner's details and
/// signed consent are recorded (D21). Only one vehicle per driver is current.
model Vehicle {
  id                     String      @id @default(uuid()) @db.Uuid
  driverId               String      @map("driver_id") @db.Uuid
  isCurrent              Boolean     @default(true) @map("is_current")
  registration           String?
  chassisNumber          String?     @map("chassis_number")
  type                   VehicleType
  makeModel              String?     @map("make_model")
  ownedByDriver          Boolean     @map("owned_by_driver")
  ownerName              String?     @map("owner_name")
  ownerPhone             String?     @map("owner_phone")
  ownerConsentFileKey    String?     @map("owner_consent_file_key")
  ownerConsentFileName   String?     @map("owner_consent_file_name")
  ownerConsentFileType   String?     @map("owner_consent_file_type")
  ownerConsentUploadedAt DateTime?   @map("owner_consent_uploaded_at") @db.Timestamptz(3)
  createdById            String?     @map("created_by_id") @db.Uuid
  createdAt              DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  driver Driver @relation(fields: [driverId], references: [id])

  agreements    Agreement[]
  installations Installation[]

  @@index([driverId])
  @@index([registration])
  @@map("vehicles")
}

// ---------------------------------------------------------------------------
// M2: agreements, installation, payments and the ledger
// ---------------------------------------------------------------------------

/// counters: gap-free number series (agreement numbers, receipts per financial year).
model Counter {
  name  String @id
  value Int

  @@map("counters")
}

enum AgreementState {
  DRAFT
  AWAITING_DOWN_PAYMENT
  AWAITING_INSTALLATION
  ACTIVE
  IN_GRACE
  IMMOBILISED
  RECOVERED
  CLOSED
  PAID_OFF
  EARLY_EXIT
  TRANSFERRED
  CANCELLED
}

/// agreements: one Neo Own agreement per driver and battery (spec module 6).
/// Plan figures are copied in from the plan version's price grid and frozen at
/// signing, so a later plan change never alters a signed contract (D15, D27).
model Agreement {
  id                  String          @id @default(uuid()) @db.Uuid
  number              String          @unique
  driverId            String          @map("driver_id") @db.Uuid
  vehicleId           String          @map("vehicle_id") @db.Uuid
  planVersionId       String          @map("plan_version_id") @db.Uuid
  batteryTypeId       String          @map("battery_type_id") @db.Uuid
  batteryId           String?         @map("battery_id") @db.Uuid
  state               AgreementState  @default(DRAFT)
  dueDay              Int             @map("due_day")
  firstDueDate        DateTime        @map("first_due_date") @db.Date
  downPayment         Int             @map("down_payment")
  instalment          Int
  termMonths          Int             @map("term_months")
  totalPayable        Int             @map("total_payable")
  graceDays           Int             @map("grace_days")
  lateFeePerDayPaise  Int             @map("late_fee_per_day_paise")
  lateFeeCapDays      Int             @map("late_fee_cap_days")
  language            DriverLanguage
  documentVersion     String          @map("document_version")
  scheduleRevision    Int             @default(1) @map("schedule_revision")
  signedAt            DateTime?       @map("signed_at") @db.Timestamptz(3)
  signatureMethod     String?         @map("signature_method")
  signedFileKey       String?         @map("signed_file_key")
  signedFileName      String?         @map("signed_file_name")
  signedFileType      String?         @map("signed_file_type")
  explainedInLanguage DriverLanguage? @map("explained_in_language")
  explainedById       String?         @map("explained_by_id") @db.Uuid
  signRecordedById    String?         @map("sign_recorded_by_id") @db.Uuid
  activatedAt         DateTime?       @map("activated_at") @db.Timestamptz(3)
  completedAt         DateTime?       @map("completed_at") @db.Timestamptz(3)
  cancelledAt         DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  cancelReason        String?         @map("cancel_reason")
  lateSpellStartedOn  DateTime?       @map("late_spell_started_on") @db.Date
  immobilisedAt       DateTime?       @map("immobilised_at") @db.Timestamptz(3)
  restoreDueSince     DateTime?       @map("restore_due_since") @db.Timestamptz(3)
  closedAt            DateTime?       @map("closed_at") @db.Timestamptz(3)
  writtenOffAmount    Int?            @map("written_off_amount")
  writtenOffLateFees  Int?            @map("written_off_late_fees")
  notes               String?
  createdById         String?         @map("created_by_id") @db.Uuid
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  driver          Driver              @relation(fields: [driverId], references: [id])
  vehicle         Vehicle             @relation(fields: [vehicleId], references: [id])
  planVersion     PlanVersion         @relation(fields: [planVersionId], references: [id])
  batteryType     BatteryType         @relation(fields: [batteryTypeId], references: [id])
  battery         Battery?            @relation(fields: [batteryId], references: [id])
  instalments     Instalment[]
  lateFees        LateFeeAccrual[]
  events          AgreementEvent[]
  installations   Installation[]
  payments        Payment[]
  immobilisations ImmobilisationLog[]
  recoveries      Recovery[]
  notices         CollectionNotice[]
  tickets         ServiceTicket[]
  replacements    BatteryReplacement[]
  transfer        OwnershipTransfer?
  paymentLinks    PaymentLink[]

  @@index([driverId])
  @@index([state])
  @@index([batteryId])
  @@map("agreements")
}

enum InstalmentStatus {
  UNPAID
  PART_PAID
  PAID
}

/// instalments: the payment table. Sequence 0 is the down payment (no due date);
/// 1..N are the monthly instalments.
model Instalment {
  id          String           @id @default(uuid()) @db.Uuid
  agreementId String           @map("agreement_id") @db.Uuid
  sequence    Int
  dueDate     DateTime?        @map("due_date") @db.Date
  amount      Int
  amountPaid  Int              @default(0) @map("amount_paid")
  status      InstalmentStatus @default(UNPAID)
  paidAt      DateTime?        @map("paid_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  agreement   Agreement           @relation(fields: [agreementId], references: [id])
  allocations PaymentAllocation[]
  lateFees    LateFeeAccrual[]

  @@unique([agreementId, sequence])
  @@index([dueDate, status])
  @@map("instalments")
}

/// late_fee_accruals: one row per agreement per day a late fee applies (D33, D38).
/// Rows are added by the collections job in M3; payments already pay them first.
model LateFeeAccrual {
  id           String   @id @default(uuid()) @db.Uuid
  agreementId  String   @map("agreement_id") @db.Uuid
  instalmentId String?  @map("instalment_id") @db.Uuid
  accrualDate  DateTime @map("accrual_date") @db.Date
  amount       Int
  amountPaid   Int      @default(0) @map("amount_paid")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  agreement   Agreement           @relation(fields: [agreementId], references: [id])
  instalment  Instalment?         @relation(fields: [instalmentId], references: [id])
  allocations PaymentAllocation[]

  @@unique([agreementId, accrualDate])
  @@map("late_fee_accruals")
}

/// agreement_events: every state change, with who and why. Append-only.
model AgreementEvent {
  id          String          @id @default(uuid()) @db.Uuid
  agreementId String          @map("agreement_id") @db.Uuid
  event       String
  fromState   AgreementState? @map("from_state")
  toState     AgreementState  @map("to_state")
  reason      String?
  actorType   ActorType       @map("actor_type")
  actorId     String?         @map("actor_id") @db.Uuid
  at          DateTime        @default(now()) @db.Timestamptz(3)

  agreement Agreement @relation(fields: [agreementId], references: [id])

  @@index([agreementId, at])
  @@map("agreement_events")
}

/// installations: the technician's record (Schedule 3, clause C2).
model Installation {
  id              String   @id @default(uuid()) @db.Uuid
  agreementId     String   @map("agreement_id") @db.Uuid
  batteryId       String   @map("battery_id") @db.Uuid
  vehicleId       String   @map("vehicle_id") @db.Uuid
  technicianId    String   @map("technician_id") @db.Uuid
  installedAt     DateTime @map("installed_at") @db.Timestamptz(3)
  location        String
  voltageReading  Decimal  @map("voltage_reading") @db.Decimal(6, 2)
  readingsNote    String?  @map("readings_note")
  conditionNote   String   @map("condition_note")
  driverConfirmed Boolean  @map("driver_confirmed")
  recordedById    String   @map("recorded_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  agreement Agreement           @relation(fields: [agreementId], references: [id])
  battery   Battery             @relation(fields: [batteryId], references: [id])
  vehicle   Vehicle             @relation(fields: [vehicleId], references: [id])
  photos    InstallationPhoto[]

  @@index([agreementId])
  @@map("installations")
}

model InstallationPhoto {
  id             String   @id @default(uuid()) @db.Uuid
  installationId String   @map("installation_id") @db.Uuid
  fileKey        String   @map("file_key")
  fileName       String   @map("file_name")
  fileType       String   @map("file_type")
  fileSize       Int      @map("file_size")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  installation Installation @relation(fields: [installationId], references: [id])

  @@index([installationId])
  @@map("installation_photos")
}

enum PaymentMethod {
  UPI
  CARD
  CASH
}

enum PaymentSource {
  MANUAL
  GATEWAY
}

/// payments: money received, each with a unique receipt number (clause B6).
/// Append-only: a correction will be a new, approved entry (PAYMENT_EDIT).
model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  receiptNumber   String        @unique @map("receipt_number")
  agreementId     String        @map("agreement_id") @db.Uuid
  driverId        String        @map("driver_id") @db.Uuid
  amount          Int
  excess          Int           @default(0)
  /// Total still to pay on the agreement (down payment and instalments) after this payment.
  balanceAfter    Int           @map("balance_after")
  method          PaymentMethod
  source          PaymentSource
  provider        String?
  providerRef     String?       @map("provider_ref")
  reference       String?
  collectedById   String?       @map("collected_by_id") @db.Uuid
  recordedById    String?       @map("recorded_by_id") @db.Uuid
  clientRequestId String?       @unique @map("client_request_id")
  note            String?
  receivedAt      DateTime      @map("received_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  agreement   Agreement           @relation(fields: [agreementId], references: [id])
  driver      Driver              @relation(fields: [driverId], references: [id])
  allocations PaymentAllocation[]
  journals    LedgerJournal[]
  messages    OutboundMessage[]

  @@unique([provider, providerRef])
  @@index([agreementId, receivedAt])
  @@index([collectedById])
  @@index([receivedAt])
  @@map("payments")
}

enum AllocationKind {
  LATE_FEE
  DOWN_PAYMENT
  INSTALMENT
  EXCESS
}

/// payment_allocations: what each payment paid for (clause B10). Append-only.
model PaymentAllocation {
  id           String         @id @default(uuid()) @db.Uuid
  paymentId    String         @map("payment_id") @db.Uuid
  kind         AllocationKind
  instalmentId String?        @map("instalment_id") @db.Uuid
  lateFeeId    String?        @map("late_fee_id") @db.Uuid
  amount       Int

  payment    Payment         @relation(fields: [paymentId], references: [id])
  instalment Instalment?     @relation(fields: [instalmentId], references: [id])
  lateFee    LateFeeAccrual? @relation(fields: [lateFeeId], references: [id])

  @@index([paymentId])
  @@index([instalmentId])
  @@map("payment_allocations")
}

enum LedgerAccount {
  GATEWAY_CLEARING
  BANK
  CASH_WITH_AGENTS
  CASH_IN_TRANSIT
  DOWN_PAYMENTS_RECEIVED
  INSTALMENTS_RECEIVED
  LATE_FEES_RECEIVED
  DRIVER_CREDIT
}

/// ledger_journals and ledger_entries: double-entry record of money movements.
/// A database check refuses any journal whose debits and credits differ.
model LedgerJournal {
  id            String   @id @default(uuid()) @db.Uuid
  kind          String
  memo          String
  paymentId     String?  @map("payment_id") @db.Uuid
  cashDepositId String?  @map("cash_deposit_id") @db.Uuid
  createdById   String?  @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  payment     Payment?      @relation(fields: [paymentId], references: [id])
  cashDeposit CashDeposit?  @relation(fields: [cashDepositId], references: [id])
  entries     LedgerEntry[]

  @@index([paymentId])
  @@index([cashDepositId])
  @@map("ledger_journals")
}

model LedgerEntry {
  id          BigInt        @id @default(autoincrement())
  journalId   String        @map("journal_id") @db.Uuid
  account     LedgerAccount
  agreementId String?       @map("agreement_id") @db.Uuid
  staffId     String?       @map("staff_id") @db.Uuid
  debit       Int           @default(0)
  credit      Int           @default(0)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  journal LedgerJournal @relation(fields: [journalId], references: [id])

  @@index([journalId])
  @@index([account, staffId])
  @@index([agreementId])
  @@map("ledger_entries")
}

enum CashDepositStatus {
  PENDING
  RECONCILED
}

/// cash_deposits: cash an agent paid into the bank, checked by finance.
model CashDeposit {
  id             String            @id @default(uuid()) @db.Uuid
  agentId        String            @map("agent_id") @db.Uuid
  amount         Int
  bankReference  String            @map("bank_reference")
  depositedAt    DateTime          @map("deposited_at") @db.Timestamptz(3)
  status         CashDepositStatus @default(PENDING)
  recordedById   String            @map("recorded_by_id") @db.Uuid
  reconciledById String?           @map("reconciled_by_id") @db.Uuid
  reconciledAt   DateTime?         @map("reconciled_at") @db.Timestamptz(3)
  note           String?
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  journals LedgerJournal[]

  @@index([agentId])
  @@index([status])
  @@map("cash_deposits")
}

enum MessageChannel {
  SMS
  WHATSAPP
}

enum MessageStatus {
  PENDING
  SENT
  FAILED
}

/// outbound_messages: every SMS or WhatsApp message sent to a driver.
model OutboundMessage {
  id          String         @id @default(uuid()) @db.Uuid
  driverId    String?        @map("driver_id") @db.Uuid
  toPhone     String         @map("to_phone")
  channel     MessageChannel
  template    String
  language    DriverLanguage
  body        String
  status      MessageStatus  @default(PENDING)
  provider    String?
  providerRef String?        @map("provider_ref")
  error       String?
  paymentId   String?        @map("payment_id") @db.Uuid
  agreementId String?        @map("agreement_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt      DateTime?      @map("sent_at") @db.Timestamptz(3)

  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([driverId, createdAt])
  @@index([paymentId])
  @@index([status])
  @@map("outbound_messages")
}

enum WebhookEventStatus {
  PROCESSED
  NEEDS_REVIEW
}

/// webhook_events: every signature-checked event from a payment provider,
/// stored once (provider + event ID), so retries are harmless.
model WebhookEvent {
  id         String             @id @default(uuid()) @db.Uuid
  provider   String
  eventId    String             @map("event_id")
  payload    Json
  status     WebhookEventStatus
  note       String?
  paymentId  String?            @map("payment_id") @db.Uuid
  receivedAt DateTime           @default(now()) @map("received_at") @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@index([status])
  @@map("webhook_events")
}

// ---------------------------------------------------------------------------
// M3: collections
// ---------------------------------------------------------------------------

enum ImmobilisationAction {
  DISABLE
  RESTORE
}

/// immobilisation_log: every disable and restore done in the GPS supplier's
/// portal, recorded by staff (D23). A disable needs an approved two-person
/// request and a confirmation that the vehicle was stationary. Append-only.
model ImmobilisationLog {
  id                         String               @id @default(uuid()) @db.Uuid
  agreementId                String               @map("agreement_id") @db.Uuid
  action                     ImmobilisationAction
  approvalRequestId          String?              @unique @map("approval_request_id") @db.Uuid
  vehicleStationaryConfirmed Boolean              @map("vehicle_stationary_confirmed")
  portalReference            String               @map("portal_reference")
  performedAt                DateTime             @map("performed_at") @db.Timestamptz(3)
  performedById              String               @map("performed_by_id") @db.Uuid
  recordedById               String               @map("recorded_by_id") @db.Uuid
  note                       String?
  createdAt                  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  agreement Agreement @relation(fields: [agreementId], references: [id])

  @@index([agreementId, performedAt])
  @@map("immobilisation_log")
}

/// recoveries: a battery collected after default (D39). Unpaid instalments and
/// late fees are written off and the agreement is closed (D45). Append-only.
model Recovery {
  id                 String          @id @default(uuid()) @db.Uuid
  agreementId        String          @unique @map("agreement_id") @db.Uuid
  batteryId          String          @map("battery_id") @db.Uuid
  approvalRequestId  String          @unique @map("approval_request_id") @db.Uuid
  recoveredAt        DateTime        @map("recovered_at") @db.Timestamptz(3)
  recoveredById      String          @map("recovered_by_id") @db.Uuid
  location           String
  conditionNote      String          @map("condition_note")
  writtenOffAmount   Int             @map("written_off_amount")
  writtenOffLateFees Int             @map("written_off_late_fees")
  recordedById       String          @map("recorded_by_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  agreement Agreement       @relation(fields: [agreementId], references: [id])
  photos    RecoveryPhoto[]

  @@map("recoveries")
}

model RecoveryPhoto {
  id         String   @id @default(uuid()) @db.Uuid
  recoveryId String   @map("recovery_id") @db.Uuid
  fileKey    String   @map("file_key")
  fileName   String   @map("file_name")
  fileType   String   @map("file_type")
  fileSize   Int      @map("file_size")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  recovery Recovery @relation(fields: [recoveryId], references: [id])

  @@index([recoveryId])
  @@map("recovery_photos")
}

enum NoticeKind {
  REMINDER_5
  REMINDER_3
  REMINDER_1
  REMINDER_0
  FINAL_NOTICE
  IMMOBILISED
  RESTORED
}

/// collection_notices: each reminder or notice sent, at most once per
/// agreement, kind and reference date (the due date or the spell start).
model CollectionNotice {
  id           String     @id @default(uuid()) @db.Uuid
  agreementId  String     @map("agreement_id") @db.Uuid
  kind         NoticeKind
  refDate      DateTime   @map("ref_date") @db.Date
  instalmentId String?    @map("instalment_id") @db.Uuid
  messageId    String?    @map("message_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  agreement Agreement @relation(fields: [agreementId], references: [id])

  @@unique([agreementId, kind, refDate])
  @@map("collection_notices")
}

enum JobRunStatus {
  RUNNING
  DONE
  FAILED
}

/// job_runs: one row per scheduled job and business date, so a date is never
/// processed twice and missed dates can be caught up.
model JobRun {
  id         String       @id @default(uuid()) @db.Uuid
  job        String
  runDate    DateTime     @map("run_date") @db.Date
  status     JobRunStatus
  summary    Json?
  startedAt  DateTime     @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime?    @map("finished_at") @db.Timestamptz(3)

  @@unique([job, runDate])
  @@map("job_runs")
}

// ---------------------------------------------------------------------------
// M4: operations
// ---------------------------------------------------------------------------

enum TicketCategory {
  NOT_WORKING
  LOW_CAPACITY
  CHARGING
  PHYSICAL_DAMAGE
  GPS_MODULE
  OTHER
}

enum TicketChannel {
  PHONE
  WHATSAPP
  FIELD_AGENT
  WALK_IN
  APP
}

enum TicketStatus {
  OPEN
  ASSIGNED
  RESOLVED
  CANCELLED
}

enum TicketOutcome {
  REPAIRED
  REPLACED
  NO_FAULT_FOUND
  NOT_COVERED
}

/// service_tickets: a fault the driver reported, with the 48-hour response
/// deadline (D48) and how it was resolved (spec module 10).
model ServiceTicket {
  id            String         @id @default(uuid()) @db.Uuid
  number        String         @unique
  agreementId   String         @map("agreement_id") @db.Uuid
  driverId      String         @map("driver_id") @db.Uuid
  batteryId     String         @map("battery_id") @db.Uuid
  category      TicketCategory
  channel       TicketChannel
  description   String
  reportedAt    DateTime       @map("reported_at") @db.Timestamptz(3)
  dueBy         DateTime       @map("due_by") @db.Timestamptz(3)
  status        TicketStatus   @default(OPEN)
  technicianId  String?        @map("technician_id") @db.Uuid
  assignedAt    DateTime?      @map("assigned_at") @db.Timestamptz(3)
  respondedAt   DateTime?      @map("responded_at") @db.Timestamptz(3)
  outcome       TicketOutcome?
  resolution    String?
  resolvedAt    DateTime?      @map("resolved_at") @db.Timestamptz(3)
  resolvedById  String?        @map("resolved_by_id") @db.Uuid
  cancelledAt   DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  cancelReason  String?        @map("cancel_reason")
  createdById   String?        @map("created_by_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  agreement    Agreement            @relation(fields: [agreementId], references: [id])
  visits       TicketVisit[]
  replacements BatteryReplacement[]

  @@index([agreementId])
  @@index([status, dueBy])
  @@index([technicianId, status])
  @@map("service_tickets")
}

/// ticket_visits: each technician visit or call on a ticket, with readings, so
/// every battery builds a service history (no BMS telemetry, B9). Append-only.
model TicketVisit {
  id             String   @id @default(uuid()) @db.Uuid
  ticketId       String   @map("ticket_id") @db.Uuid
  batteryId      String   @map("battery_id") @db.Uuid
  technicianId   String   @map("technician_id") @db.Uuid
  visitedAt      DateTime @map("visited_at") @db.Timestamptz(3)
  voltageReading Decimal? @map("voltage_reading") @db.Decimal(6, 2)
  readingsNote   String?  @map("readings_note")
  finding        String
  recordedById   String   @map("recorded_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket ServiceTicket @relation(fields: [ticketId], references: [id])
  photos TicketPhoto[]

  @@index([ticketId])
  @@index([batteryId, visitedAt])
  @@map("ticket_visits")
}

model TicketPhoto {
  id        String   @id @default(uuid()) @db.Uuid
  visitId   String   @map("visit_id") @db.Uuid
  fileKey   String   @map("file_key")
  fileName  String   @map("file_name")
  fileType  String   @map("file_type")
  fileSize  Int      @map("file_size")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  visit TicketVisit @relation(fields: [visitId], references: [id])

  @@index([visitId])
  @@map("ticket_photos")
}

/// battery_replacements: a faulty battery swapped for another of the same type
/// on the same agreement and payment schedule (clause C8). Append-only.
model BatteryReplacement {
  id             String   @id @default(uuid()) @db.Uuid
  agreementId    String   @map("agreement_id") @db.Uuid
  ticketId       String   @map("ticket_id") @db.Uuid
  oldBatteryId   String   @map("old_battery_id") @db.Uuid
  newBatteryId   String   @map("new_battery_id") @db.Uuid
  technicianId   String   @map("technician_id") @db.Uuid
  replacedAt     DateTime @map("replaced_at") @db.Timestamptz(3)
  voltageReading Decimal  @map("voltage_reading") @db.Decimal(6, 2)
  oldBatteryNote String   @map("old_battery_note")
  recordedById   String   @map("recorded_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  agreement Agreement     @relation(fields: [agreementId], references: [id])
  ticket    ServiceTicket @relation(fields: [ticketId], references: [id])

  @@index([agreementId])
  @@index([ticketId])
  @@map("battery_replacements")
}

/// ownership_transfers: the battery passes to the driver once everything is
/// paid (clause E9, D32): GPS switched off in the supplier's portal, Schedule 8
/// certificate issued, service ends. One per agreement. Append-only.
model OwnershipTransfer {
  id                 String   @id @default(uuid()) @db.Uuid
  agreementId        String   @unique @map("agreement_id") @db.Uuid
  batteryId          String   @map("battery_id") @db.Uuid
  driverId           String   @map("driver_id") @db.Uuid
  certificateNumber  String   @unique @map("certificate_number")
  paidInFullOn       DateTime @map("paid_in_full_on") @db.Date
  gpsOffAt           DateTime @map("gps_off_at") @db.Timestamptz(3)
  gpsPortalReference String   @map("gps_portal_reference")
  gpsOffById         String   @map("gps_off_by_id") @db.Uuid
  transferredAt      DateTime @map("transferred_at") @db.Timestamptz(3)
  recordedById       String   @map("recorded_by_id") @db.Uuid
  note               String?
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  agreement Agreement @relation(fields: [agreementId], references: [id])

  @@map("ownership_transfers")
}

// ---------------------------------------------------------------------------
// M5: UPI payment links (Cashfree)
// ---------------------------------------------------------------------------

enum PaymentLinkStatus {
  ACTIVE
  PAID
  EXPIRED
  CANCELLED
}

/// payment_links: a UPI payment link sent to a driver by SMS. The gateway
/// reports the payment by signed webhook, which records it like any other
/// payment (late fees first, then the oldest instalment).
model PaymentLink {
  id           String            @id @default(uuid()) @db.Uuid
  linkId       String            @unique @map("link_id")
  agreementId  String            @map("agreement_id") @db.Uuid
  driverId     String            @map("driver_id") @db.Uuid
  gateway      String
  gatewayRef   String?           @map("gateway_ref")
  url          String
  /// Sent by SMS as https://api.voltcompany.in/p/<shortCode> (DLT variable limit)
  shortCode    String?           @unique @map("short_code")
  amount       Int
  purpose      String
  status       PaymentLinkStatus @default(ACTIVE)
  expiresAt    DateTime          @map("expires_at") @db.Timestamptz(3)
  paymentId    String?           @unique @map("payment_id") @db.Uuid
  closedAt     DateTime?         @map("closed_at") @db.Timestamptz(3)
  closedNote   String?           @map("closed_note")
  createdById  String?           @map("created_by_id") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  agreement Agreement @relation(fields: [agreementId], references: [id])

  @@index([agreementId, status])
  @@map("payment_links")
}
