# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://voltneo:voltneo@localhost:5432/voltneo
# Used by the end-to-end tests. The tests reset this database.
TEST_DATABASE_URL=postgresql://voltneo:voltneo@localhost:5432/voltneo_test

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
OTP_HASH_SECRET=change-me-otp-secret-at-least-32-characters

# Encrypts KYC ID numbers. 32 random bytes, base64: openssl rand -base64 32
# Losing this key makes stored ID numbers unreadable; keep it in the secret manager.
# The value below is for local development only.
KYC_ENCRYPTION_KEY=ZGV2LW9ubHkta3ljLWtleS1kby1ub3QtdXNlLTMyYnk=

# Private folder for uploaded KYC documents and consent forms (never web-served).
FILE_STORAGE_DIR=./storage
FILE_LINK_TTL_SECONDS=300

# Token lifetimes
ACCESS_TOKEN_TTL_SECONDS=900
# Admin panel sessions end after this much inactivity (spec section 7)
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# OTP
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# Message delivery. "log" prints OTPs to the server log (development only).
# Real SMS and email adapters are added when the founder picks providers.
OTP_DELIVERY=log

# Receipts and other driver messages (SMS/WhatsApp). "log" writes them to the
# server log; a real provider adapter is added once the founder picks one.
MESSAGE_DELIVERY=log

# Payment webhooks. Only the built-in "test" provider exists until a payment
# gateway account is opened. Leave empty to switch it off.
# Generate with: openssl rand -base64 48
PAYMENT_TEST_WEBHOOK_SECRET=

# Scheduled jobs (daily collections check 00:05 IST, reminders 09:00 IST) run on
# Redis. Turn on in exactly the processes that should run them.
JOBS_ENABLED=true
REDIS_URL=redis://localhost:6379

# Origin of the admin panel, for CORS and cookies
ADMIN_ORIGIN=http://localhost:3000

# First super admin, created by `pnpm db:seed` if no staff exist yet
BOOTSTRAP_SUPER_ADMIN_NAME=Volt Neo Admin
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@voltneo.example
BOOTSTRAP_SUPER_ADMIN_PHONE=
